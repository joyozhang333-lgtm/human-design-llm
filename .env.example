DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TEMPERATURE=0.45
DEEPSEEK_MAX_TOKENS=1800

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# 生成模式：llm | fallback（默认：有 key 走 llm，无 key 走 fallback）
HD_GENERATION_MODE=
# LLM 提供方：deepseek | claude（默认 deepseek）
HD_LLM_PROVIDER=
# 生成缓存路径（默认项目根目录 cache.db）
HD_CACHE_PATH=

MINIMAX_API_KEY=
MINIMAX_IMAGE_ENDPOINT=https://api.minimax.io/v1/image_generation
MINIMAX_IMAGE_MODEL=image-01
MINIMAX_RESPONSE_FORMAT=base64
